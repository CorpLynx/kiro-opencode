{
  "name": "opencode-ghe-policy",
  "version": "0.1.0",
  "description": "opencode plugin that enforces an organization policy kept in GitHub Enterprise: config lockdown, command guardrails and commit provenance",
  "license": "MIT",
  "type": "module",
  "keywords": ["opencode", "opencode-plugin", "github-enterprise", "policy", "governance"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./server": { "types": "./dist/server.d.ts", "import": "./dist/server.js" },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "bash e2e/run.sh"
  },
  "peerDependencies": { "@opencode-ai/plugin": ">=1.0.0" },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.19.3",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}

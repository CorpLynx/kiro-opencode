# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
build/
dist/

# Node / Bun
node_modules/
*.tsbuildinfo

# Editors and OS
.idea/
.vscode/
.DS_Store

# Never commit secrets or real data
*.key
.env

# Output from real runs of topomapper (account IDs, hostnames, addresses).
# Write snapshots and diagrams under topomapper-out/ and they stay out of commits.
# (The topomap-* lines cover folders from before the tool was renamed.)
topomapper-out/
topomap-out/
tools/topomapper/*.json
tools/topomapper/*.drawio
tools/topomapper/*.mmd
tools/topomapper/*.svg
tools/topomapper/*.dot
tools/topomap/

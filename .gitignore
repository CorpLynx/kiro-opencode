# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
build/
dist/

# Node / Bun
node_modules/
*.tsbuildinfo

# Editors and OS
.idea/
.vscode/
.DS_Store

# Never commit secrets or real data
*.key
.env

# Output from real runs of topomap (account IDs, hostnames, addresses).
# Write snapshots and diagrams under topomap-out/ and they stay out of commits.
topomap-out/
tools/topomap/*.json
tools/topomap/*.drawio
tools/topomap/*.mmd
tools/topomap/*.svg
tools/topomap/*.dot

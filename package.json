{
  "name": "opencode-kiro-provider",
  "version": "0.1.0",
  "description": "opencode plugin that adds Kiro (AWS CodeWhisperer / Amazon Q Developer) as a model provider",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "kiro",
    "codewhisperer",
    "aws",
    "provider"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./tui": {
      "types": "./dist/tui.d.ts",
      "import": "./dist/tui.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "test:e2e": "bash e2e/run.sh"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.0.0",
    "@opentui/solid": ">=0.4.5",
    "solid-js": "^1.9.0"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.19.3",
    "@opentui/core": "^0.4.5",
    "@opentui/solid": "^0.4.5",
    "@types/node": "^22.0.0",
    "solid-js": "^1.9.12",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "@opentui/solid": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  }
}
